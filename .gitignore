.venv/
venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.ruff_cache/
# Anchored to the repo root: unanchored `build/` also matched `docs/build/`
# and silently excluded the build specs.
/dist/
/build/
*.egg-info/
.DS_Store
node_modules/

# Framework build caches. Kept at root because the web client's own .gitignore
# will not exist until build spec 07 recreates it — and its absence is exactly
# how 63 .svelte-kit artifacts got committed in 07abaaf.
.svelte-kit/
.vercel/
.output/
