# API config. Copy to .env for local dev; never commit .env.
# Deployed, these are set as Cloud Run env vars / secrets — DATABASE_URL is a
# secret, FIREBASE_PROJECT_ID is not.

# Postgres. Local Docker (see docker-compose.yml):
DATABASE_URL=postgresql://fantasy:fantasy@127.0.0.1:5432/fantasy
# Neon, deployed — use the POOLED (PgBouncer) endpoint, and a separate branch
# per environment so migrations can be rehearsed. See docs/SETUP.md step 6:
# DATABASE_URL=postgresql://<user>:<pw>@<ep>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Firebase Auth — the SAME project as fantasy-tds, so UIDs (and the existing
# user↔Sleeper links) carry over. firebase-admin verifies ID tokens against
# Google's public keys; no service-account JSON is needed for verification
# alone. See ADR 0001.
FIREBASE_PROJECT_ID=your-firebase-project-id
