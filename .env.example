# Convex backend env vars — set via `npx convex env set KEY value`, never committed.
#
# Firebase Auth is the identity provider. Convex validates Firebase ID tokens
# against Google's public JWKS, so there is nothing secret on this side — no
# signing keys, no OAuth client secret, no service-account JSON.
#
# FIREBASE_PROJECT_ID builds both halves of the OIDC config in
# convex/auth.config.ts:
#   iss → https://securetoken.google.com/<project-id>
#   aud → <project-id>
#
# Use the SAME project as fantasy-tds — shared UIDs are the point (ADR 0001).
# Find it in the Firebase console → Project settings → Project ID.

FIREBASE_PROJECT_ID=your-firebase-project-id
