# Convex backend secrets — set via `npx convex env set`, never committed.
#
# Generate JWT_PRIVATE_KEY and JWKS:
#   npx @convex-dev/auth generate-keys
#
# SITE_URL is the URL Convex Auth uses for OAuth redirect URIs. In development
# this is your Convex deployment's .convex.site URL (printed by `npx convex dev`).

SITE_URL=https://your-deployment.convex.site
JWT_PRIVATE_KEY=
JWKS=

# Google OAuth credentials — create at console.cloud.google.com
# Authorized redirect URI: ${SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
