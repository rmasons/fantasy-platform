# Copy to .env for local dev. On Railway these become service variables.
APP_ENV=local

# Local: points at the Docker Postgres in docker-compose.yml.
# Railway: set to the PRIVATE Postgres connection string (the *.railway.internal
# host), so the DB is never exposed publicly. Same code, different value.
DATABASE_URL=postgresql://fantasy:fantasy@localhost:5432/fantasy

SLEEPER_BASE_URL=https://api.sleeper.app/v1

# CORS — the web frontend origin(s) allowed to call this API. Comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Firebase Auth (leave blank locally — the API runs with a dev bypass user when
# unset in APP_ENV=local). In prod set the project id and provide service-account
# creds via GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
