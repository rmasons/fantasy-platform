# Copy to web/.env.local for local dev.
#
# PUBLIC_CONVEX_URL — Convex deployment URL for queries/mutations/subscriptions.
# Printed by `npx convex dev` as "WebSocket URL" (https://your-name.convex.cloud).
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# PUBLIC_CONVEX_SITE_URL — HTTP endpoint for auth routes added by convex/http.ts.
# Usually the same deployment with the .convex.site TLD, e.g.:
# https://your-deployment.convex.site
# Used to build the Google OAuth sign-in redirect URL.
PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
