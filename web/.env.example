# Copy to web/.env.local for local dev.
#
# PUBLIC_CONVEX_URL — Convex deployment URL for queries/mutations/subscriptions.
# Printed by `npx convex dev` as "WebSocket URL" (https://your-name.convex.cloud).
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Firebase web app config. All six are public by design (they identify the
# project, they don't authorize anything — access is controlled by Firebase Auth
# and by Convex function-level checks). Firebase console → Project settings →
# Your apps → SDK setup and configuration.
#
# Use the SAME Firebase project as fantasy-tds so UIDs — and therefore the
# existing user↔Sleeper links — carry over. These values are identical to the
# ones in fantasy-tds/.env.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
